# This patch initializes i->a[Gene] = new Gene[modesCount] instead of i->a = new Gene[40]
# However, it does NOT load the new genes from savefiles. For compatibility, this is done in the code.
# this patch is inside of i.b() (deobfuscated name: loadGenome()) which loads a genome from a file.
{com/saterskog/cell_lab/i.smali: {line: 3689, override:true, patches:{'sget v0, Lcom/saterskog/cell_lab/CellAccess;->modesCount:I'}}}
{com/saterskog/cell_lab/i.smali: {line: 3695, override:false, patches:{
            'const/4 v1, 0  # index counter',
            ':loop_start',
            'sget v0, Lcom/saterskog/cell_lab/CellAccess;->modesCount:I',
            'if-ge v1, v0, :loop_end  # Stop when index >= modesCount',
            'new-instance v0, Lcom/saterskog/cell_lab/Gene;',
            'invoke-direct {v0}, Lcom/saterskog/cell_lab/Gene;-><init>()V',
            'aput-object v0, v5, v1  # Store object in Gene[] at index v1',
            'add-int/lit8 v1, v1, 1 ',
            'goto :loop_start'  ,
            ':loop_end',
            'const/16 v0, 0x28'
        }
    }
}
